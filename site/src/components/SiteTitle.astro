---
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import { docsVersion, docsVersions, projectBase } from '../../versions.mjs';

const versions = docsVersions();
const current = docsVersion();
---

<div class="version-title">
	<Default />
	{
		versions.length > 0 && (
			<label class="version">
				<span class="sr-only">Version</span>
				<select class="version-select" data-root={projectBase}>
					{versions.map((version) => (
						<option value={version} selected={version === current}>
							{version}
						</option>
					))}
				</select>
			</label>
		)
	}
</div>

<script>
	const select = document.querySelector('select.version-select');
	if (select instanceof HTMLSelectElement) {
		const root = select.dataset.root ?? '';
		select.addEventListener('change', () => {
			const base = import.meta.env.BASE_URL;
			const prefix = base.endsWith('/') ? base : `${base}/`;
			const path = window.location.pathname;
			let rest = path.startsWith(prefix) ? path.slice(prefix.length) : '';
			rest = rest.replace(/^(?:v\d+\.\d+\.\d+\/)+/, '');
			if (/^v\d+\.\d+\.\d+$/.test(rest)) rest = '';
			window.location.assign(`${root}/${select.value}/${rest}`);
		});
	}
</script>

<style>
	.version-title {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
	}

	.version {
		display: inline-flex;
		flex-shrink: 0;
	}

	.version-select {
		font: inherit;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text);
		background: var(--sl-color-bg-nav);
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.25rem;
		padding: 0.1rem 0.35rem;
	}
</style>
